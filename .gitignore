# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets — NEVER commit these
.env
.env.*
# ...but the template IS committed (negation must be its own line, no trailing comment):
!.env.example
secrets/
*.key
*.pem

# Claude Code — personal & runtime state stays OUT of the (deployable) main branch.
#   Committed: .claude/skills/ (team contract) and *.example deploy templates.
#   Ignored:   live settings (machine-specific paths) + channel runtime state
#              (bot token in .env, per-deployer allowlist in access.json).
# To set up locally: cp .claude/settings.json.example .claude/settings.json
.claude/settings.json
.claude/settings.local.json
.claude/channels/

# Per-person progress logs (if you choose to use the per-person pattern)
claude-progress-*.md

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Data — adjust to your project
data/raw/
data/tmp/
*.csv
*.parquet
*.pkl

# Notebooks
.ipynb_checkpoints/

# ── Citation Verifier — runtime artifacts (don't commit) ──────────────────
# Per-paper artifact dirs: source, refs, report.json/run.json, downloaded PDFs.
# Keep papers/.gitkeep so the dir exists on a fresh clone.
papers/*
!papers/.gitkeep
papers/*.pdf
papers/*/
# Exception: one full agentic run kept as a tracked demo example (report.md +
# report.json + run.json). The rest of papers/ stays ignored. Re-include the
# dir before its files — papers/*/ excludes the parent, and git cannot re-add a
# file whose parent dir is still excluded.
!papers/s12559-023-10236-2-agentic/
!papers/s12559-023-10236-2-agentic/*
# Second tracked demo: an author-year PDF (citation sites recovered via hyperlinks).
!papers/For_testing-agentic/
!papers/For_testing-agentic/*

# Generated reports written to the repo root (e.g. report-<id>.md/json).
report-*.md
report-*.json

# Off-repo dataset cache (full CitationHallucinationBench lives on /scratch).
chbench_data/

# NOTE: spec/ , config/ , evals/smoke/ and tests/fixtures/ ARE committed.

# cverify-bot runtime log (from `python -m citation_verifier.bot`)
logs_bot.log
