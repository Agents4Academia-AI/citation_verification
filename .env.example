# citation_verifier — environment template.
# Copy to .env (gitignored) and fill in. NOTHING here is required to run the
# keyless floor (schema + render + eval + Crossref/arXiv grounding).

# ── LLM backend (only needed for the 'claude_code' backend / live verification) ──
# Claude Agent SDK uses an authed Claude Code install OR this key.
ANTHROPIC_API_KEY=

# Two-tier model routing (overridable; never hard-coded in source).
# bulk  = cheap, high-throughput correctness pass.
# judge = strong model for relevance / justification.
MODEL_BULK=claude-haiku-4-5
MODEL_JUDGE=claude-opus-4-5

# Per-run USD ceiling (orchestrator aborts gracefully past this). 0 = no cap.
COST_CEILING_USD=0.50

# ── Grounding sources ──
# Crossref "polite pool": identify yourself for higher rate limits (no key needed).
CROSSREF_MAILTO=

# Optional keyed sources. Absent => those sources are skipped (keyless floor stays up).
S2_API_KEY=
OPENALEX_API_KEY=

# Gate web search/fetch (last-resort grounding). false => never call the web.
ENABLE_WEB_SEARCH=false

# ── Paths ──
# Per-paper artifact dir (source, refs, report.json, run.json).
PAPERS_DIR=papers
# Full CitationHallucinationBench lives off-repo; smoke gold ships in evals/smoke/.
CHBENCH_DATA_DIR=/scratch/datasets/chbench
