# citation_verifier — environment template.
# Copy to .env (gitignored) and fill in. NOTHING here is required to run the
# keyless floor (schema + render + eval + Crossref/arXiv grounding); the
# 'agentic' backend and the Discord bot's default path need no API key.

# ── LLM backend (only needed for the 'claude_code' backend / live verification) ──
# Auth is automatic: DEFAULT = your Claude Code SUBSCRIPTION (log in via `claude`,
# leave this blank). Provide a key here (or as an env var) to use the per-token API
# instead.
ANTHROPIC_API_KEY=

# Two-tier model routing (overridable; never hard-coded in source). Use REAL
# model ids — bulk = cheap/high-throughput correctness, judge = strong model
# for relevance/justification (also the model the 'claude_code' backend uses).
MODEL_BULK=claude-haiku-4-5-20251001
MODEL_JUDGE=claude-opus-4-8

# Per-run USD ceiling. 0 = no cap. A pass is not started once the run's spend has reached
# it: the relevance pass, then each comparison table in turn. Sized for a whole paper —
# citations alone measure $0.7-$3.9 per paper, and table cells roughly $0.09 each.
COST_CEILING_USD=10.00

# The LLM relevance judge (STEP 2) in the 'agentic' backend — ON by default
# (relevance is the core check). Uses the Claude Code subscription + MODEL_JUDGE;
# judges from abstract (+intro/full text), honestly abstaining when the specific
# evidence isn't there, and degrades to abstention if no SDK/auth is present. Set
# false to force keyless abstention on relevance.
ENABLE_RELEVANCE_JUDGE=true

# Verify the ✓/✗ cells of related-work comparison tables against the cited papers, as
# part of every run (results tables are never touched). Uses the same model transport as
# the relevance judge; one cell is one call carrying the whole cited paper, so
# TABLE_MAX_CELLS bounds a run (tables past it are reported, not judged; 0 = no cap) and
# COST_CEILING_USD stops further tables once reached. `cverify --tables on|off|only`
# overrides per run.
ENABLE_TABLE_VERIFICATION=true
TABLE_MAX_CELLS=150

# ── Grounding sources ──
# Crossref "polite pool": identify yourself for higher rate limits (no key needed).
CROSSREF_MAILTO=

# Optional keyed sources. Absent => those sources are skipped (keyless floor stays up).
S2_API_KEY=
# OpenAlex: used both for the OpenAlex grounding source AND for open-access
# full-text PDF lookup (Stage-2 escalation). Keyless works (rate-limited); a key
# enables the polite pool. SUPPLY YOUR OWN — never commit it.
OPENALEX_API_KEY=

# Open-access full-text escalation (Stage 2) — all OPTIONAL, all user-provided,
# keyless-first; absent => that source is simply skipped (fail-soft).
#   UNPAYWALL_EMAIL — Unpaywall requires a contact email (no key); enables its OA PDFs.
#   CONTACT_EMAIL   — polite User-Agent / OpenAlex mailto fallback for OA lookups.
UNPAYWALL_EMAIL=
CONTACT_EMAIL=

# Last-resort web search for references no index found: a model with web search finds the
# work's pages, and the code checks them (an index record behind the URL, or the page's own
# title + owner). On by default; it runs only in runs that use a model (the relevance judge),
# at most WEB_SEARCH_MAX_LOOKUPS times per paper, each with up to WEB_SEARCH_MAX_USES searches
# (a lookup costs roughly $0.03-0.20). false => never.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_LOOKUPS=50
WEB_SEARCH_MAX_USES=8

# A cited work whose PDF is a scan (no text layer) is transcribed by the bulk model so the
# relevance judge can read it — only in runs that use a model; read once, then cached.
READ_SCANS=true
SCAN_MAX_PAGES=20

# ── Discord bot (cverify-bot) ──
# Create an application + bot at https://discord.com/developers/applications,
# then paste the *bot token* here. Required to run `cverify-bot`.
DISCORD_BOT_TOKEN=
# Register /check INSTANTLY in one server: enable Developer Mode, right-click the
# server icon → Copy Server ID, paste it here. Blank => global (slow, ~1h) sync.
DISCORD_GUILD_ID=
# Backend used when /check is called without one ('agentic' or 'claude_code').
BOT_DEFAULT_BACKEND=agentic
# Test-sample size: a bare /check verifies only the first N citations and labels
# the result a loud 🧪 PARTIAL test run. full:true ignores this and verifies ALL
# citations (the real verdict) — uncapped; long runs still deliver via a channel
# @mention past Discord's 15-min window, so DO NOT re-add a global cap.
BOT_TEST_LIMIT=5
# Caching is OFF by default during the testing phase: every /check runs fresh.
# Set to 1 to resume a prior report.json (repeat checks return instantly, marked ♻️).
BOT_USE_CACHE=0
# (BOT_MAX_CITATIONS is retired and ignored — replaced by BOT_TEST_LIMIT + full:true.)

# ── Paths ──
# Per-paper artifact dir (source, refs, report.json, run.json).
PAPERS_DIR=papers
# Full CitationHallucinationBench lives off-repo; smoke gold ships in evals/smoke/.
CHBENCH_DATA_DIR=/scratch/datasets/citation_verification_benchmark
